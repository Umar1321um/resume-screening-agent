# Copy this file to .env and fill in ONE provider's key (or none -- the
# agent works end-to-end without any key, using a rule-based fallback
# explanation instead of an LLM-generated one).

# Option A: Anthropic (Claude)
ANTHROPIC_API_KEY=

# Option B: OpenAI
OPENAI_API_KEY=

# Option C: Groq (free tier available)
GROQ_API_KEY=

# Optional overrides:
# LLM_PROVIDER=anthropic   # force a provider instead of auto-detecting from keys above; set to "none" to disable LLM calls
# LLM_MODEL=claude-sonnet-5    # override the default model for the active provider
